generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  headline    String
  description String
  location    String?
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum LinkKind {
  GITHUB
  LINKEDIN
  TELEGRAM
  WEBSITE
  EMAIL
  OTHER
}

model Link {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      LinkKind
  label     String
  url       String
  position  Int

  @@unique([profileId, url])
  @@index([profileId, position])
}

enum SkillCategory {
  LANGUAGE
  BACKEND
  DATABASE
  DEVOPS
  FRONTEND
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

model Skill {
  id        Int            @id @default(autoincrement())
  profileId Int
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  SkillCategory
  level     SkillLevel
  position  Int
  projects  ProjectSkill[]

  @@unique([profileId, name])
  @@index([profileId, position])
}

model Experience {
  id           Int       @id @default(autoincrement())
  profileId    Int
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  summary      String?
  achievements String[]
  startedAt    DateTime  @db.Date
  endedAt      DateTime? @db.Date
  projects     Project[]

  @@unique([profileId, company, startedAt])
  @@index([profileId, startedAt])
}

model Project {
  id            Int            @id @default(autoincrement())
  profileId     Int
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experienceId  Int?
  experience    Experience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  name          String
  description   String
  url           String
  repositoryUrl String?
  position      Int
  stack         ProjectSkill[]

  @@unique([profileId, name])
  @@index([profileId, position])
  @@index([experienceId])
}

model ProjectSkill {
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   Int
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  position  Int

  @@id([projectId, skillId])
  @@index([skillId])
}
